TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если Telegram доступен только через прокси/VPN, а zakupki.gov.ru — без:
# TELEGRAM_HTTPS_PROXY=http://127.0.0.1:7890
# TELEGRAM_HTTP_PROXY=http://127.0.0.1:7890
# TELEGRAM_SPOOL_ON_FAIL=1
# Ссылка на web_ui для TG (любой из вариантов):
# REPORT_SITE_PUBLIC_BASE_URL=http://192.168.1.10:8765
# WEB_UI_PUBLIC_BASE_URL=http://192.168.1.10:8765
# WEB_UI_PUBLIC_HOST=192.168.1.10
# WEB_UI_PORT=8765
# PM.bi CRM: кнопка "Добавить в CRM" в web_ui
# PMBI_CRM_URL=http://127.0.0.1:8080
# PMBI_CRM_LOGIN=admin
# PMBI_CRM_PASSWORD=
# PMBI_CRM_MAX_MATERIALS=2000
# TELEGRAM_SEND_MERGE_EXCEL=0
# TELEGRAM_SEND_ESTIMATE_EXCEL=0
SKIP_PERPLEXITY_TXT=1
RUN_MARKET=1
MARKET_MAX_ROWS=0
MARKET_PAUSE_SEC=18
MARKET_SOURCES=avito,web
MARKET_AVITO_HEADLESS=0
# Для команды /info и botctl.py info можно задать отдельные настройки:
# MARKET_SUMMARY_SOURCES=avito,web
# MARKET_SUMMARY_REGION=Челябинская область
# MARKET_SUMMARY_MAX_RESULTS=5
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
# RESEARCH_BOT_ACCEPT_PLAIN=1
MAIN_MAX_PAGES=2
MAIN_MAX_TENDERS=15
MAIN_DAYS_BACK=60
# Полный прогон main: для закупок «Подача заявок» в tenders.json — перечитать этап с карточки ЕИС (сайт + TG при смене).
# REFRESH_CACHED_STAGES=1
# REFRESH_CACHED_STAGES_MAX=40
